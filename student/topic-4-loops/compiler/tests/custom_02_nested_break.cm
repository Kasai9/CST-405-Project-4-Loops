
/*
 * Test: Nested Loops and Break
 * Checks that break exits only the inner loop.
 *
 * Expected output:
 * 14
 * 4
 */

int main() {
    int i;
    int j;
    int sum;

    i = 0;
    sum = 0;

    while (i < 4) {
        for (j = 0; j < 5; j = j + 1) {
            sum = sum + 2;
            break;
        }

        sum = sum + i;
        i = i + 1;
    }

    print(sum);
    print(i);

    return 0;
}
