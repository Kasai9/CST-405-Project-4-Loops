
/*
 * Test: Zero-Iteration Loops
 * Checks that loops skip their bodies when conditions are false.
 *
 * Expected output:
 * 7
 * 5
 */

int main() {
    int i;
    int sum;

    i = 3;
    sum = 7;

    while (i < 3) {
        sum = sum + 100;
    }

    for (i = 5; i < 2; i = i + 1) {
        sum = sum + 100;
    }

    print(sum);
    print(i);

    return 0;
}
