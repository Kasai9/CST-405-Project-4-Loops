
/*
 * Test: For Loop and Operator Precedence
 *
 * Expected output:
 * 98
 * 7
 * 20
 */

int main() {
    int i;
    int result;

    result = 0;

    for (i = 0; i + 1 < 2 * 4; i = i + 1) {
        result = result + 2 + 3 * 4;
    }

    print(result);
    print(i);
    print((2 + 3) * 4);

    return 0;
}
